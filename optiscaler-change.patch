From bd3e2d97e493168de647e300d2d2ee7d605bf071 Mon Sep 17 00:00:00 2001
From: Astyyyyy <imapotatook123@gmail.com>
Date: Mon, 26 Oct 2026 16:05:23 +1030
Subject: [PATCH] amdvlk windows add a compiler config for RT_NT cache hints

---
 OptiScaler.ini                    |  5 ++++
 OptiScaler/Config.cpp             |  3 ++
 OptiScaler/Config.h               |  2 ++
 OptiScaler/dllmain.cpp            |  2 ++
 OptiScaler/hooks/Vulkan_Hooks.cpp | 49 +++++++++++++++++++++++++++++++
 OptiScaler/hooks/Vulkan_Hooks.h   |  2 ++
 6 files changed, 63 insertions(+)

diff --git a/OptiScaler.ini b/OptiScaler.ini
index dfb3fbd90..1436c7cad 100644
--- a/OptiScaler.ini
+++ b/OptiScaler.ini
@@ -1694,6 +1694,11 @@ RestoreGraphicSignature=auto
 ; true or false - Default (auto) is false
 ExtendedStateRestore=auto
 
+; Experimental AMD Windows compute image-read RT_NT cache hint; requires a process restart
+; Applies to all compute shaders. No effect on Linux
+; true or false - Default (auto) is false
+VulkanAmdImageReadRtNt=auto
+
 ; Use precompiled shaders for RCAS, Output Scaling and Mask Bias
 ; true or false - Default (auto) is true
 UsePrecompiledShaders=auto
diff --git a/OptiScaler/Config.cpp b/OptiScaler/Config.cpp
index c578bf4ea..d8a5453ae 100644
--- a/OptiScaler/Config.cpp
+++ b/OptiScaler/Config.cpp
@@ -654,6 +654,7 @@ bool Config::Reload(std::filesystem::path iniPath)
             PreferDedicatedGpu.set_from_config(readBool("Hotfix", "PreferDedicatedGpu"));
             PreferFirstDedicatedGpu.set_from_config(readBool("Hotfix", "PreferFirstDedicatedGpu"));
             SkipFirstFrames.set_from_config(readInt("Hotfix", "SkipFirstFrames"));
+            VulkanAmdImageReadRtNt.set_from_config(readBool("Hotfix", "VulkanAmdImageReadRtNt"));
             UsePrecompiledShaders.set_from_config(readBool("Hotfix", "UsePrecompiledShaders"));
             ColorResourceBarrier.set_from_config(readInt("Hotfix", "ColorResourceBarrier"));
             MVResourceBarrier.set_from_config(readInt("Hotfix", "MotionVectorResourceBarrier"));
@@ -1821,6 +1822,8 @@ bool Config::SaveIni()
                      GetBoolValue(Instance()->ExtendedStateRestore.value_for_config()).c_str());
         ini.SetValue("Hotfix", "SkipFirstFrames", GetIntValue(Instance()->SkipFirstFrames.value_for_config()).c_str());
 
+        ini.SetValue("Hotfix", "VulkanAmdImageReadRtNt",
+                     GetBoolValue(Instance()->VulkanAmdImageReadRtNt.value_for_config()).c_str());
         ini.SetValue("Hotfix", "UsePrecompiledShaders",
                      GetBoolValue(Instance()->UsePrecompiledShaders.value_for_config()).c_str());
         ini.SetValue("Hotfix", "PreferDedicatedGpu",
diff --git a/OptiScaler/Config.h b/OptiScaler/Config.h
index a613d2fdf..a1b8565af 100644
--- a/OptiScaler/Config.h
+++ b/OptiScaler/Config.h
@@ -500,6 +500,8 @@ class Config
     CustomOptional<bool, SoftDefault> RestoreGraphicSignature { false };
     CustomOptional<bool, SoftDefault> ExtendedStateRestore { false };
 
+    CustomOptional<bool, SoftDefault> VulkanAmdImageReadRtNt { false };
+
     CustomOptional<bool> UsePrecompiledShaders { true };
 
     CustomOptional<bool> UseGenericAppIdWithDlss { false };
diff --git a/OptiScaler/dllmain.cpp b/OptiScaler/dllmain.cpp
index c738e4e62..438cc06a5 100644
--- a/OptiScaler/dllmain.cpp
+++ b/OptiScaler/dllmain.cpp
@@ -1784,6 +1784,8 @@ BOOL APIENTRY DllMain(HMODULE hModule, DWORD ul_reason_for_call, LPVOID lpReserv
         spdlog::info("");
         CheckQuirks(possibleNvidia);
 
+        VulkanHooks::PrepareAmdImageReadRtNt();
+
         // Check for working mode and attach hooks
         spdlog::info("");
         CheckWorkingMode();
diff --git a/OptiScaler/hooks/Vulkan_Hooks.cpp b/OptiScaler/hooks/Vulkan_Hooks.cpp
index c9dcb8059..c2a8dac59 100644
--- a/OptiScaler/hooks/Vulkan_Hooks.cpp
+++ b/OptiScaler/hooks/Vulkan_Hooks.cpp
@@ -5,6 +5,7 @@
 #include <Util.h>
 #include <Config.h>
 #include <SysUtils.h>
+#include <fstream>
 
 #include <menu/menu_overlay_vk.h>
 #include <menu/menu_common.h>
@@ -241,6 +242,52 @@ static bool EnableRadvCooperativeMatrix2()
     return setUnixEnv && setUnixEnv("radv_cooperative_matrix2_nv", "true") >= 0;
 }
 
+// AMD reads these settings during physical device initialization, before vkCreateDevice.
+// The opt in profile affects image reads in all compute shaders in the process.
+bool VulkanHooks::PrepareAmdImageReadRtNt()
+{
+    if (State::Instance().isRunningOnLinux || !Config::Instance()->VulkanAmdImageReadRtNt.value_or_default())
+        return false;
+
+    static const bool prepared = []
+    {
+        try
+        {
+            const auto directory = std::filesystem::temp_directory_path() /
+                                   (L"OptiScaler-amd-rtnt-" + std::to_wstring(GetCurrentProcessId()) + L"-" +
+                                    std::to_wstring(GetTickCount64()));
+            std::filesystem::create_directories(directory);
+
+            std::ofstream config(directory / L"amdVulkanSettings.cfg", std::ios::binary);
+            config << "OverrideShaderParams,1\n"
+                      "OverrideShaderStage,7\n"            // Compute
+                      "OverrideTemporalHintImageRead,6\n"; // TH_RT_NT
+            config.close();
+            if (!config)
+            {
+                LOG_WARN("AMD image-read RT_NT setup failed: settings file could not be written");
+                return false;
+            }
+
+            if (_wputenv_s(L"AMD_CONFIG_DIR", directory.c_str()) != 0)
+            {
+                LOG_WARN("AMD image-read RT_NT setup failed: environment could not be updated");
+                return false;
+            }
+
+            LOG_INFO("Prepared AMD compute image-read RT_NT profile at {} (requires early Vulkan initialization)",
+                     wstring_to_string(directory.wstring()));
+            return true;
+        }
+        catch (const std::exception& error)
+        {
+            LOG_WARN("AMD image-read RT_NT setup failed: {}", error.what());
+            return false;
+        }
+    }();
+    return prepared;
+}
+
 static void HookDevice(VkDevice InDevice)
 {
     if (o_CreateSwapchainKHR != nullptr || State::Instance().vulkanSkipHooks)
@@ -497,6 +544,8 @@ static VkResult hkvkCreateInstance(const VkInstanceCreateInfo* pCreateInfo, cons
 {
     LOG_FUNC();
 
+    VulkanHooks::PrepareAmdImageReadRtNt();
+
     VkInstanceCreateInfo localCreateInfo {};
     memcpy(&localCreateInfo, pCreateInfo, sizeof(VkInstanceCreateInfo));
 
diff --git a/OptiScaler/hooks/Vulkan_Hooks.h b/OptiScaler/hooks/Vulkan_Hooks.h
index 4583173c7..b59e7fe61 100644
--- a/OptiScaler/hooks/Vulkan_Hooks.h
+++ b/OptiScaler/hooks/Vulkan_Hooks.h
@@ -9,6 +9,8 @@ class VulkanHooks
     static PFN_vkCreateSemaphore o_vkCreateSemaphore;
     static PFN_vkAntiLagUpdateAMD o_vkAntiLagUpdateAMD;
 
+    static bool PrepareAmdImageReadRtNt();
+
     // The device's vkSignalSemaphore, or vkSignalSemaphoreKHR on devices with only VK_KHR_timeline_semaphore.
     // VK_ERROR_FEATURE_NOT_PRESENT when the device has neither.
     static VkResult SignalSemaphore(VkDevice device, const VkSemaphoreSignalInfo* pSignalInfo);
